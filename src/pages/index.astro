---
import Base from '../layouts/Base.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Shows from '../components/Shows.astro';
import { featuredProjects } from '../lib/projects';
import { url } from '../lib/url';
const projects = await featuredProjects();
---
<Base current="featured">
  <section class="intro">
    <p class="lede">
      Sung is an artist-researcher materializing fractures of control at the seams of body, technology, and nature.
    </p>
    <p class="sub"><a href={url('/about')}>About</a> · <a href={url('/projects')}>All projects</a></p>
  </section>
  <div class="section-head">
    <h2 class="section-title">Recent exhibitions</h2>
    <a href={url('/about#exhibitions')}>Full CV →</a>
  </div>
  <Shows limit={5} />
  <h2 class="section-title">Featured</h2>
  <ProjectGrid projects={projects} />
</Base>
