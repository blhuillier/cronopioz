---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
const bundle = url('/pagefind/');
---
<Base title="Search" current="search">
  <h1 class="page-title">Search</h1>
  <link href={`${bundle}pagefind-ui.css`} rel="stylesheet" />
  <div id="search" data-bundle={bundle}></div>
  <noscript>Search needs JavaScript.</noscript>
  <script is:inline src={`${bundle}pagefind-ui.js`}></script>
  <script is:inline>
    const el = document.getElementById('search');
    if (window.PagefindUI) {
      new PagefindUI({ element: '#search', bundlePath: el.dataset.bundle, showImages: true, showSubResults: false, resetStyles: false });
    } else {
      el.textContent = 'Search index not found (it is generated by `npm run build`).';
    }
  </script>
</Base>
