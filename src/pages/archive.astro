---
import Base from '../layouts/Base.astro';
import { allProjects, projectPath } from '../lib/projects';
import { url, CATEGORY_LABEL } from '../lib/url';
const projects = await allProjects();
const byYear = new Map<number, typeof projects>();
for (const p of projects) {
  const y = p.data.date.getUTCFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
---
<Base title="Archive" current="archive">
  <h1 class="page-title">Archive</h1>
  <div class="archive">
    {[...byYear].map(([year, list]) => (
      <section>
        <h2>{year}</h2>
        <ul>
          {list.map((p) => (
            <li>
              <a href={url(projectPath(p))}>{p.data.title}</a>
              <span>{p.data.categories.map((c) => CATEGORY_LABEL[c] ?? c).join(' · ')}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
